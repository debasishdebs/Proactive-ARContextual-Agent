# Paths that must NEVER reach a public branch. Used by push_clean.sh (git filter-repo --invert-paths --paths-from-file).
# A plain line is a file or a directory prefix; "glob:" lines use shell-style patterns where * also crosses "/".
# Personal = the owner's handoffs, rulings, plans for trips and devices, agent memory, local review records with coordinates.
# Public on purpose: README, ROADMAP (kept free of personal rows by hand), PRIVACY, THIRD_PARTY_NOTICES, docs/ARCHITECTURE and the
# design docs under docs/superpowers/plans and specs, tools, tests.

# handoffs, owner decisions and rulings, spike handoffs, release plans, device checklists, install recoveries (the whole folder)
docs/superpowers/plans/handoffs/
docs/superpowers/decisions/
glob:docs/superpowers/specs/*handoff*
HANDOFF.md
glob:HANDOFF-*.md
MORNING.md

# agent working memory and per-task reports
.superpowers/
code-agent/claude/memory/
code-agent/handoffs/
glob:code-agent/superpowers/sdd/*handoff*
code-agent/superpowers/sdd/2026-10-25-v095/codex-rulings-merge.md

# owner planning documents that carry trip dates and device state
docs/superpowers/plans/2026-11-16-roadmap-v1.1-v1.3.md
docs/superpowers/plans/2026-11-18-backlog-v15-v2-non-nexus.md
docs/superpowers/plans/2026-11-19-path-to-v2.0.md

# review records that carry coordinates or trip itineraries
glob:docs/superpowers/reviews/*hyderabad*
glob:docs/superpowers/reviews/*trip-seed-coverage*
glob:docs/superpowers/reviews/*trip-rehearsal*

# secrets and local config, belt and braces (they are also git-ignored)
local.properties
glob:*/keystore.properties
keystore.properties
glob:*.jks
