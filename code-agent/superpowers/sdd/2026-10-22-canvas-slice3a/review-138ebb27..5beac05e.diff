diff --git a/android-companion/glasses/src/test/java/com/rokid/context/glasses/capture/golden/DecisionGoldenRecorder.kt b/android-companion/glasses/src/test/java/com/rokid/context/glasses/capture/golden/DecisionGoldenRecorder.kt
