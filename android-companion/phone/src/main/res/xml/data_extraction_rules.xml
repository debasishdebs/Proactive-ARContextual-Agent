<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Same exclusions as backup_rules.xml, for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="endpoint_keys.xml" />
        <exclude domain="sharedpref" path="db_key.xml" />
        <exclude domain="sharedpref" path="app_config_secret.xml" />
        <exclude domain="sharedpref" path="ai_seed.xml" />
        <exclude domain="sharedpref" path="legacy_import.xml" />
        <exclude domain="database" path="context.db" />
        <exclude domain="database" path="context.db-wal" />
        <exclude domain="database" path="context.db-shm" />
        <exclude domain="file" path="rokid_archive" />
        <exclude domain="file" path="rokid_inbox" />
        <exclude domain="file" path="queue_runtime.log" />
        <exclude domain="file" path="memory_records.log" />
        <exclude domain="file" path="captured_frames.log" />
        <exclude domain="file" path="summary_trace.log" />
        <exclude domain="root" path="cache/exports" />
        <exclude domain="file" path="models" />
        <!-- BUG-R3-1: set-up, DB and device state. Restored onto a fresh install (no keys, no DB) these said
             onboarding was done, pointed into the missing DB, or carried another phone's pairing / voice probe.
             Ruling and the restorable list: BackupRulesTest. -->
        <exclude domain="sharedpref" path="onboarding.xml" />
        <exclude domain="sharedpref" path="app_config.xml" />
        <exclude domain="sharedpref" path="memory_graph.xml" />
        <exclude domain="sharedpref" path="index_maintenance.xml" />
        <exclude domain="sharedpref" path="pipeline_stats.xml" />
        <exclude domain="sharedpref" path="rokid_link.xml" />
        <exclude domain="sharedpref" path="rokid_bridge.xml" />
        <exclude domain="sharedpref" path="voice_probe.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="endpoint_keys.xml" />
        <exclude domain="sharedpref" path="db_key.xml" />
        <exclude domain="sharedpref" path="app_config_secret.xml" />
        <exclude domain="sharedpref" path="ai_seed.xml" />
        <exclude domain="sharedpref" path="legacy_import.xml" />
        <exclude domain="database" path="context.db" />
        <exclude domain="database" path="context.db-wal" />
        <exclude domain="database" path="context.db-shm" />
        <exclude domain="file" path="rokid_archive" />
        <exclude domain="file" path="rokid_inbox" />
        <exclude domain="file" path="queue_runtime.log" />
        <exclude domain="file" path="memory_records.log" />
        <exclude domain="file" path="captured_frames.log" />
        <exclude domain="file" path="summary_trace.log" />
        <exclude domain="root" path="cache/exports" />
        <exclude domain="file" path="models" />
        <!-- BUG-R3-1: set-up, DB and device state. Restored onto a fresh install (no keys, no DB) these said
             onboarding was done, pointed into the missing DB, or carried another phone's pairing / voice probe.
             Ruling and the restorable list: BackupRulesTest. -->
        <exclude domain="sharedpref" path="onboarding.xml" />
        <exclude domain="sharedpref" path="app_config.xml" />
        <exclude domain="sharedpref" path="memory_graph.xml" />
        <exclude domain="sharedpref" path="index_maintenance.xml" />
        <exclude domain="sharedpref" path="pipeline_stats.xml" />
        <exclude domain="sharedpref" path="rokid_link.xml" />
        <exclude domain="sharedpref" path="rokid_bridge.xml" />
        <exclude domain="sharedpref" path="voice_probe.xml" />
    </device-transfer>
</data-extraction-rules>
