<?xml version="1.0" encoding="utf-8"?>
<!-- API <= 30. Encrypted key prefs restore without their Keystore master key, and the Room DB needs one of them
     (SQLCipher passphrase), so keys (and the legacy key file app_config_secret.xml, plaintext on some old builds), DB and the "done in DB"
     markers are excluded, and so are the copies of memory text kept outside the DB. Everything else is backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="endpoint_keys.xml" />
    <exclude domain="sharedpref" path="db_key.xml" />
    <exclude domain="sharedpref" path="app_config_secret.xml" />
    <!-- B12: copies of the legacy key file found in files/ after a restore. Rules match a path exactly (or a
         directory and everything under it), never a wildcard, so the name and the two restored copies are listed;
         SecretBakCleanup deletes any other app_config_secret.xml.bak.* at start-up. -->
    <exclude domain="file" path="app_config_secret" />
    <exclude domain="file" path="app_config_secret.xml.bak.1780057256" />
    <exclude domain="file" path="app_config_secret.xml.bak.manual_reset_1780057830" />
    <exclude domain="sharedpref" path="ai_seed.xml" />
    <exclude domain="sharedpref" path="legacy_import.xml" />
    <exclude domain="database" path="context.db" />
    <exclude domain="database" path="context.db-wal" />
    <exclude domain="database" path="context.db-shm" />
    <!-- Place pack (places.db, SQLCipher under the db_key that is itself excluded): public place text plus the recency of what was looked at. Never backed up or transferred. The user's pinned places live in place_pins.xml (exact coordinates, names and notes: private, so also excluded from every backup and transfer; kept by Delete all and carried only by the explicit settings export, which the user chooses to share). places.db is rebuilt from it at start. -->
    <exclude domain="database" path="places.db" />
    <exclude domain="database" path="places.db-wal" />
    <exclude domain="database" path="places.db-shm" />
    <exclude domain="database" path="places.db-journal" />
    <exclude domain="sharedpref" path="place_pins.xml" />
    <!-- v3.0 proactive loop (shadow): the Suggestions switches are per-device consent and the shadow store holds place keys and source ids (encrypted, Keystore-bound): never backed up or transferred; Delete all clears both. -->
    <exclude domain="sharedpref" path="proactive_settings.xml" />
    <exclude domain="sharedpref" path="proactive_shadow.xml" />
    <exclude domain="sharedpref" path="proactive_dismiss_marker.xml" />
    <!-- Copies of memory text outside the DB: frame JPEGs, the queue log, the legacy logs, the exports. -->
    <exclude domain="file" path="rokid_archive" />
    <exclude domain="file" path="rokid_inbox" />
    <exclude domain="file" path="queue_runtime.log" />
    <exclude domain="file" path="memory_records.log" />
    <exclude domain="file" path="captured_frames.log" />
    <exclude domain="file" path="summary_trace.log" />
    <exclude domain="root" path="cache/exports" />
    <!-- Downloaded on-device models: large and re-downloadable. -->
    <exclude domain="file" path="models" />
    <!-- Final review I4: the photo test's labels (the user's own words about their photos) and results. -->
    <exclude domain="file" path="photo-eval" />
    <!-- BUG-R3-1: set-up, DB and device state. Restored onto a fresh install (no keys, no DB) these said
         onboarding was done, pointed into the missing DB, or carried another phone's pairing / voice probe.
         Ruling and the restorable list: BackupRulesTest. -->
    <exclude domain="sharedpref" path="onboarding.xml" />
    <exclude domain="sharedpref" path="app_config.xml" />
    <exclude domain="sharedpref" path="memory_graph.xml" />
    <exclude domain="sharedpref" path="index_maintenance.xml" />
    <exclude domain="sharedpref" path="pipeline_stats.xml" />
    <exclude domain="sharedpref" path="rokid_link.xml" />
    <exclude domain="sharedpref" path="rokid_bridge.xml" />
    <exclude domain="sharedpref" path="relaunch_state.xml" />
    <exclude domain="sharedpref" path="voice_probe.xml" />
    <!-- Derived state: a restore must not claim adoption or retirement already happened. -->
    <exclude domain="sharedpref" path="frame_adoption.xml" />
    <exclude domain="sharedpref" path="space_retired_at.xml" />
    <exclude domain="sharedpref" path="image_read_attempts.xml" />
    <exclude domain="sharedpref" path="night_index.xml" />
    <!-- Wave B: opt-in context sources, my-car addresses, LiveFit digest, watch epoch/seq: every source is off after a restore. -->
    <exclude domain="sharedpref" path="ctx_hub_state.xml" />
    <exclude domain="sharedpref" path="hub_restart.xml" />
    <exclude domain="sharedpref" path="periodic_cadence.xml" />
    <exclude domain="sharedpref" path="hub_auto_stop.xml" />
    <!-- Canvas slice 2: the Developer mode switch is a per-device debug flag: off after a restore. -->
    <exclude domain="sharedpref" path="pc_dev.xml" />
    <!-- AI call pace paces this phone's own model calls: per-device, default after a restore. -->
    <exclude domain="sharedpref" path="ai_call_pace.xml" />
    <exclude domain="sharedpref" path="index_battery.xml" />
    <exclude domain="sharedpref" path="window_tolerance.xml" />
    <exclude domain="sharedpref" path="signal_config.xml" />
    <exclude domain="sharedpref" path="device_capabilities.xml" />
    <exclude domain="sharedpref" path="fusion_settings.xml" />
    <exclude domain="sharedpref" path="capture_timing.xml" />
    <!-- Opt-in privacy switch "Send matching photos with questions": off after a restore. -->
    <exclude domain="sharedpref" path="ask_photos.xml" />
    <!-- Canvas slice 3a: the persisted deletion epoch, the plan and collection state, the mark settings (per-install; a restored epoch would let another
         install's data pass its fence), and the sealed traces, pulled imports and tmp files (sensor and label data, never exported). Ruling: BackupRulesTest. -->
    <exclude domain="sharedpref" path="deletion_epoch.xml" />
    <exclude domain="sharedpref" path="canvas_plan_state.xml" />
    <exclude domain="sharedpref" path="canvas_collect.xml" />
    <exclude domain="sharedpref" path="mark_settings.xml" />
    <!-- Export cleanup: pending-delete bookkeeping for exported files (MemoryExport.CLEANUP_PREFS), per-install state. -->
    <exclude domain="sharedpref" path="export_cleanup.xml" />
    <!-- Pause zones: the recent past of THIS phone (latched state, last clear-fix time, clock-rollback total); a restore would describe a place and time it never saw. -->
    <exclude domain="sharedpref" path="pause_zone_state.xml" />
    <!-- Offline map (PMTiles): the saved choice (a document URI whose read grant does not survive a restore) and an imported private copy of the user's own map file (large, re-importable). Never backed up or transferred. -->
    <exclude domain="sharedpref" path="offline_map.xml" />
    <exclude domain="file" path="offline_maps" />
    <!-- Street map (opt-in): the switch and its first-time consent are per-device (OFF again after a restore). The tile cache lives in the cache folder, which is never backed up. -->
    <exclude domain="sharedpref" path="online_map.xml" />
    <!-- Place Guide switch: per-device, off again after a restore -->
    <exclude domain="sharedpref" path="place_guide.xml" />
    <!-- Roaming data saver: mode, "I'm abroad" and today's skipped counts are per-device (a restore onto another phone would be wrong there): back to the default (Wi-Fi and home mobile data) after a restore. -->
    <exclude domain="sharedpref" path="data_saver.xml" />
    <!-- Model privacy (slice 1.4.3): Automatic or Offline only is per-device (a restore onto another phone would be wrong there): back to Automatic after a restore. -->
    <exclude domain="sharedpref" path="ai_backend.xml" />
    <!-- Rokid Nexus HUD host choice (v2.0): per-device consent, PCA again after a restore -->
    <exclude domain="sharedpref" path="nexus_host.xml" />
    <!-- 3b WP2: the helper capability grants (py_exec, default off) are per-install consent: a restore or a device transfer never turns a grant on. -->
    <exclude domain="sharedpref" path="canvas_helper_grants.xml" />
    <exclude domain="file" path="canvas_traces" />
    <exclude domain="file" path="canvas_import" />
    <exclude domain="file" path="canvas_tmp" />
    <!-- Final pass 10: the dev-mode trace staging folder (raw sensor traces, adb-readable) under the EXTERNAL files dir. -->
    <exclude domain="external" path="trace-staging" />
    <!-- Always-on logging LGC2: files/logs (pca.log and pca.log.N segments, up to about 300 MB) is a per-install diagnostic record (counts only, but device-specific): never backed up or transferred. -->
    <exclude domain="file" path="logs" />
    <!-- LGC2: the pending log-wipe request is per-install. -->
    <exclude domain="sharedpref" path="log_wipe_state.xml" />
</full-backup-content>
