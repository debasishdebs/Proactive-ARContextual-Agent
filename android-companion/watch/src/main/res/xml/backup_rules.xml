<?xml version="1.0" encoding="utf-8"?>
<!-- API <= 30. Backup is off (allowBackup="false"); every domain is excluded too, in case it is ever switched on. Ruling: WatchManifestPolicyTest. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
