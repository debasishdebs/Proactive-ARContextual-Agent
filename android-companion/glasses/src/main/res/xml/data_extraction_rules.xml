<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. S2: allowBackup="false" doesn't stop device-to-device transfer when targetSdk >= 31, so both sections
     exclude every domain: no photos, session state or settings leave the glasses. Ruling: GlassesBackupRulesTest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <!-- Canvas slice 3a (S81): the capture plan, the mark queue, the IMU traces and their tmp folder. The blanket excludes above already cover them;
             they are named so GlassesBackupRulesTest pins them and a future narrowing of the blanket cannot silently expose sensor data. -->
        <exclude domain="sharedpref" path="capture_plan.xml" />
        <exclude domain="sharedpref" path="mark_queue.xml" />
        <exclude domain="file" path="imu_trace" />
        <exclude domain="file" path="imu_trace_tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <!-- Canvas slice 3a (S81): the capture plan, the mark queue, the IMU traces and their tmp folder. The blanket excludes above already cover them;
             they are named so GlassesBackupRulesTest pins them and a future narrowing of the blanket cannot silently expose sensor data. -->
        <exclude domain="sharedpref" path="capture_plan.xml" />
        <exclude domain="sharedpref" path="mark_queue.xml" />
        <exclude domain="file" path="imu_trace" />
        <exclude domain="file" path="imu_trace_tmp" />
    </device-transfer>
</data-extraction-rules>
