<?xml version="1.0" encoding="utf-8"?>
<!-- API <= 30. S2: backup is off (allowBackup="false"); nothing on the glasses is worth restoring (camera frames in the
     outbound buffer, pause/link/capture session state, a HUD settings cache the phone re-sends). Every domain is
     excluded too, in case backup is ever switched on. Ruling: GlassesBackupRulesTest. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
