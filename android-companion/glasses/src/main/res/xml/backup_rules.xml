<?xml version="1.0" encoding="utf-8"?>
<!-- API <= 30. S2: backup is off (allowBackup="false"); nothing on the glasses is worth restoring (camera frames in the
     outbound buffer, pause/link/capture session state, a HUD settings cache the phone re-sends). Every domain is
     excluded too, in case backup is ever switched on. Ruling: GlassesBackupRulesTest. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <!-- Canvas slice 3a (S81): the capture plan, the mark queue, the IMU traces and their tmp folder. The blanket excludes above already cover them;
         they are named so GlassesBackupRulesTest pins them and a future narrowing of the blanket cannot silently expose sensor data. -->
    <exclude domain="sharedpref" path="capture_plan.xml" />
    <exclude domain="sharedpref" path="mark_queue.xml" />
    <exclude domain="file" path="imu_trace" />
    <exclude domain="file" path="imu_trace_tmp" />
</full-backup-content>
