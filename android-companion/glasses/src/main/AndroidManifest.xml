<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CaptureService and CaptureScheduler (kept after Task 12). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Push-to-talk (Phase 6): the glasses' own mic; the audio goes to the phone's on-device recognizer only. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Minimised icon and pop-ups (spec 2026-10-14 §3): overlay windows; Settings.canDrawOverlays gates them at runtime. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProactiveContext.Hud">
        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera" />
        <receiver
            android:name=".capture.CaptureAlarmReceiver"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|locale|layoutDirection|fontScale"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
