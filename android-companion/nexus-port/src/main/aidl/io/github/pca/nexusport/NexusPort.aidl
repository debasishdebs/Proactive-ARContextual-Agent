package io.github.pca.nexusport;

import io.github.pca.nexusport.NexusPortCallback;
import io.github.pca.nexusport.NexusSkillHost;

/**
 * PCA phone app -> Nexus bridge. Plain primitives only (no Parcelable, so the wire cannot grow a field by accident).
 * ONLY NexusHudSink calls this (NexusChokePointTest). Every method returns a NexusResult code and never throws for a domain failure.
 * [slot] is a Slot code: 1 notice, 2 pin, 3 activity, 4 surface, 5 speech.
 */
interface NexusPort {
    /** The wire version of this interface (NexusPortVersion.CURRENT). */
    int apiVersion();
    /** Registers the one callback (actions, speech end, history-forget accepted). Null clears it. */
    void setCallback(NexusPortCallback callback);
    /** Feature bits the user switched on in PCA (NexusFeatures). 0 = everything off: the bridge hides all and refuses speech. Default in the bridge: 0. */
    int setFeatures(int mask);
    /** Shows a notice (slot 1) or a pin (slot 2). actionIds/actionLabels are parallel arrays (notice only). */
    int show(int slot, String title, String text, long ttlMs, boolean wake, in String[] actionIds, in String[] actionLabels);
    /** Hides what [slot] shows. Idempotent. */
    int hide(int slot);
    /** Speaks [text] on the glasses (needs the TTS feature bit). One voice: a new line preempts. */
    int speak(String text);
    /** Stops the speech now. Idempotent. */
    int stopSpeech();
    /** Asks the hub to forget every notice this bridge showed (history). The callback says when it is accepted. */
    int forgetHistory();
    // ---- appended in 2.0 T5/T6 (additive: the transaction ids above are unchanged) ----
    /** Stops the Nexus speech-to-text session of an assist-button ask now (a trip). Idempotent. */
    int stopListening();
    /** Registers the phone's skill host (T6), or null to clear it. The bridge answers skill calls ONLY through it; with none set every skill call fails with the domain code `unavailable`. */
    int setSkillHost(NexusSkillHost host);
    // ---- appended in the v2 r2 fix (additive: older transaction ids unchanged; PROTOCOL_VERSION stays 1) ----
    /** [show] stamped with the phone's trip epoch: the bridge drops it (STALE) when it was told of a later trip ([tripAt]), also when the trip lands while the show is drawn (it is hidden again). */
    int showAt(long epoch, int slot, String title, String text, long ttlMs, boolean wake, in String[] actionIds, in String[] actionLabels);
    /** [speak] stamped with the phone's trip epoch (same rule as [showAt]). */
    int speakAt(long epoch, String text);
    /** The phone tells the bridge the latest trip epoch (monotonic max). Cheap and non-blocking in the bridge: it only records it. */
    int tripAt(long epoch);
    /** [forgetHistory] carrying the debt generation it covers; the bridge reports it back in [NexusPortCallback.onForgetAcceptedAt]. */
    int forgetHistoryAt(long generation);
    // ---- appended in the v2 r4 fix (additive; PROTOCOL_VERSION stays 1). An older bridge has no such transaction: the call fails (RemoteException) and the sink treats it as unhealthy, fail closed. ----
    /** Opens the phone's connection SESSION (random 64 bit, never 0, generated by the phone per connect): resets the epoch counter, replaces the bridge's session. Idempotent for the same session. Every call below carries it. */
    int beginSession(long session);
    /** [showAt] carrying the session: refused (STALE) when it is not the current one. The result carries NexusResult.CREATED_HISTORY when a notice may have reached the hub's history. */
    int showIn(long session, long epoch, int slot, String title, String text, long ttlMs, boolean wake, in String[] actionIds, in String[] actionLabels);
    /** [speakAt] carrying the session (same rule as [showIn]). */
    int speakIn(long session, long epoch, String text);
    /** [tripAt] carrying the session: refused (STALE) when it is not the current one. */
    int tripIn(long session, long epoch);
    /** [forgetHistoryAt] carrying the session. */
    int forgetHistoryIn(long session, long generation);
}
